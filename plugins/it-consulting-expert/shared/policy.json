{
  "_about": "Single source of truth for every number the sier engine uses. Skills and agents must not restate these values; they read this file or call the engine. Change a policy here and every calculation, test and document follows.",
  "schema_version": 1,

  "rubric": {
    "_about": "Go/No-Go rubric (rfp-analysis). Weights must sum to 1.0.",
    "scale": {"min": 1, "max": 5},
    "dimensions": [
      {"id": "strategic_fit",         "en": "Strategic Fit",         "ja": "戦略適合性",       "weight": 0.15},
      {"id": "capability_match",      "en": "Capability Match",      "ja": "技術適合性",       "weight": 0.25},
      {"id": "win_probability",       "en": "Win Probability",       "ja": "受注確度",         "weight": 0.25},
      {"id": "profitability",         "en": "Profitability",         "ja": "収益性",           "weight": 0.15},
      {"id": "delivery_risk",         "en": "Delivery Risk",         "ja": "デリバリーリスク", "weight": 0.10},
      {"id": "resource_availability", "en": "Resource Availability", "ja": "リソース確保",     "weight": 0.10}
    ],
    "thresholds": [
      {"min": 4.0, "verdict": "STRONG_GO",      "ja": "強く推奨",   "action": "Prioritize this bid."},
      {"min": 3.0, "verdict": "CONDITIONAL_GO", "ja": "条件付きGO", "action": "Proceed only if the stated conditions are met."},
      {"min": 2.0, "verdict": "LIKELY_NO_GO",   "ja": "非推奨",     "action": "Proceed only with executive sponsor approval."},
      {"min": 0.0, "verdict": "DEFINITE_NO_GO", "ja": "見送り",     "action": "Decline politely."}
    ],
    "mandatory_gate": "If any mandatory RFP qualification is unmet with no credible workaround, the verdict is DEFINITE_NO_GO regardless of the weighted score."
  },

  "estimation": {
    "_about": "effort-estimation. Phase ranges are typical shares of the base (pre-PM) effort for SIer waterfall work.",
    "days_per_mm": 20,
    "hours_per_day": 8,
    "phases": [
      {"id": "requirements",     "ja": "要件定義",       "en": "Requirements Definition", "range": [0.10, 0.15]},
      {"id": "basic_design",     "ja": "基本設計",       "en": "Basic Design",            "range": [0.15, 0.20]},
      {"id": "detailed_design",  "ja": "詳細設計",       "en": "Detailed Design",         "range": [0.15, 0.20]},
      {"id": "implementation",   "ja": "製造",           "en": "Implementation",          "range": [0.20, 0.25]},
      {"id": "integration_test", "ja": "結合テスト",     "en": "Integration Testing",     "range": [0.10, 0.15]},
      {"id": "system_test",      "ja": "総合テスト",     "en": "System Testing",          "range": [0.10, 0.15]},
      {"id": "deployment",       "ja": "移行・リリース", "en": "Deployment & Transition", "range": [0.05, 0.10]}
    ],
    "pm_overhead": {"default": 0.12, "range": [0.10, 0.15]},
    "factors": {
      "_about": "Multiplicative adjustment factors and their allowed bounds. 1.0 is neutral and always allowed.",
      "technical_complexity": {"ja": "技術的複雑性",     "bounds": [0.8, 1.5]},
      "team_experience":      {"ja": "チーム経験",       "bounds": [0.7, 1.3]},
      "requirements_clarity": {"ja": "要件明確性",       "bounds": [0.9, 1.4]},
      "distributed_team":     {"ja": "分散チーム",       "bounds": [1.0, 1.3]},
      "regulatory":           {"ja": "規制・コンプライアンス", "bounds": [1.0, 1.5]},
      "integration_complexity": {"ja": "連携の複雑さ",   "bounds": [1.0, 1.5]}
    },
    "three_point": {"optimistic": 0.8, "most_likely": 1.0, "pessimistic": 1.5, "recommended": 1.2},
    "max_task_days": 5,
    "function_points": {
      "weights": {
        "EI":  {"low": 3, "avg": 4,  "high": 6},
        "EO":  {"low": 4, "avg": 5,  "high": 7},
        "EQ":  {"low": 3, "avg": 4,  "high": 6},
        "ILF": {"low": 7, "avg": 10, "high": 15},
        "EIF": {"low": 5, "avg": 7,  "high": 10}
      },
      "vaf": {"base": 0.65, "per_point": 0.01, "gsc_count": 14, "gsc_max": 5},
      "_scope_note": "Hours-per-FP benchmarks cover design, coding and unit test only. Requirements, integration test and system test are added as shares of that core effort; PM is added via pm_overhead.",
      "extra_phase_shares": {"requirements": 0.125, "integration_test": 0.125, "system_test": 0.125}
    }
  },

  "commercial": {
    "_about": "cost-estimation. Fees and premiums are each computed on the cost subtotal (they do not compound).",
    "currency": "JPY",
    "tax_rate": 0.10,
    "mgmt_fee_rate": {"default": 0.10, "range": [0.05, 0.15]},
    "risk_premium_fixed": {"default": 0.15, "range": [0.15, 0.25]},
    "round_to": 1000,
    "under_budget_warning": 0.20,
    "estimate_reconciliation_tolerance": 0.05,
    "role_reconciliation": {"_about": "Per-role check: flag a role whose team 人月 differs from the estimate's allocation by more than this share AND by more than min_mm.", "tolerance": 0.25, "min_mm": 2},
    "maintenance_rate": {"default": 0.15, "range": [0.15, 0.20]}
  },

  "evm": {
    "_about": "progress-report. Source: progress-report/references/report-templates.md and project-delivery/references/quality-metrics.md.",
    "spi": {"green_min": 0.95, "red_below": 0.85},
    "cpi": {"green_min": 0.95, "red_below": 0.85},
    "eac_over_bac": {"green_max": 1.10, "red_above": 1.20},
    "tcpi": {"green_max": 1.10, "red_above": 1.20}
  },

  "change_control": {
    "_about": "change-request. Cumulative deviation gates and approval authority.",
    "gates": {"yellow_above": 0.10, "red_above": 0.20},
    "authority": {
      "pm":       {"max_cost_exclusive": 1000000, "max_days_exclusive": 5},
      "director": {"max_cost_inclusive": 5000000, "max_days_inclusive": 15},
      "executive_if_go_live_changes": true
    }
  },

  "maintenance": {
    "_about": "maintenance-proposal.",
    "month_hours_24x7": 720,
    "business_hours_per_day": 9,
    "business_days_per_month": 20,
    "uplift_24x7": {"range": [0.40, 0.60]},
    "multi_year_discount": {"3": 0.05, "5": 0.10},
    "availability_tiers": [
      {"id": "standard", "target": 99.5,  "window": "business_hours"},
      {"id": "enhanced", "target": 99.9,  "window": "24x7"},
      {"id": "premium",  "target": 99.95, "window": "24x7"}
    ]
  },

  "harness": {
    "_about": "Tier-2 generated code (sier derive). These keys are owned by Tier-1 engines; a derived script may not emit them.",
    "contractual_keys": [
      "grand_total", "price_tax_excluded", "price_tax_included", "total_price",
      "recommended_mm", "recommended_days", "weighted_score", "verdict",
      "labor_total", "cost_subtotal", "eac", "bac"
    ],
    "timeout_seconds": 120
  }
}
